# Copy this file to `.env` (which is git-ignored) and fill in your key.
# Get a key at https://physiology.presagetech.com/
SMARTSPECTRA_API_KEY=

# Optional. SDK usage telemetry is OFF by default in Calm Desk.
# Set to 1 to opt in (see Presage's Telemetry and Privacy page for what it covers).
SMARTSPECTRA_TELEMETRY=0
